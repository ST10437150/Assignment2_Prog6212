@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }
<div class="page-head"><div><h1>My results</h1><p>Your race history across every completed event.</p></div></div>

@if (Model.Count == 0)
{
    <div class="panel text-center py-5"><h2>No results yet</h2><p class="text-muted mb-0">Once an organiser publishes results for an event you entered, they'll appear here.</p></div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var r in Model)
        {
            <div class="result-card">
                <div>
                    <h3 class="mb-0"><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventID" class="text-decoration-none">@r.EventName</a></h3>
                    <span class="text-muted">@r.EventDate.ToString("d MMMM yyyy") &middot; @r.CategoryName (@Formatting.Km(r.DistanceKm))</span>
                </div>
                <div class="text-end">
                    <div class="result-time">@Formatting.Time(r.FinishTime)</div>
                    @if (r.Position is { } pos)
                    {
                        <div><span class="result-place">@Formatting.Ordinal(pos)</span> <span class="text-muted">out of @r.TotalFinishers finishers</span></div>
                    }
                </div>
            </div>
        }
    </div>
}
