@model EventEnrolmentsViewModel
@{ ViewData["Title"] = "Enrolments"; }
<div class="page-head">
    <div><h1>Enrolments</h1><p>@Model.Event.Name &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p></div>
    <a asp-controller="ManageEvents" asp-action="Index" class="btn btn-outline-ink">Back to my events</a>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="panel text-center py-5"><h2>No participants yet</h2><p class="text-muted mb-0">Enrolments will appear here as people sign up.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table">
            <thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Enrolments)
            {
                <tr>
                    <td><strong>@e.ParticipantName</strong><br /><span class="text-muted small">@e.ParticipantEmail</span></td>
                    <td>@e.CategoryName <span class="text-muted">(@Formatting.Km(e.DistanceKm))</span></td>
                    <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                    <td><partial name="_StatusBadge" model="e.Status" /></td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">
                            @if (e.Status != "Confirmed")
                            {
                                <form asp-action="SetStatus" method="post">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                    <input type="hidden" name="id" value="@e.EnrolmentID" />
                                    <input type="hidden" name="status" value="Confirmed" />
                                    <button type="submit" class="btn btn-sm btn-ink">Confirm</button>
                                </form>
                            }
                            @if (e.Status != "Cancelled" && e.FinishTime is null)
                            {
                                <form asp-action="SetStatus" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                    <input type="hidden" name="id" value="@e.EnrolmentID" />
                                    <input type="hidden" name="status" value="Cancelled" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
