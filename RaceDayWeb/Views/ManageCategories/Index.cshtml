@model EventDto
@{
    ViewData["Title"] = "Categories";
    var form = (CategoryFormModel)ViewBag.NewCategory;
}
<div class="page-head">
    <div><h1>Categories</h1><p>@Model.Name &middot; @Model.EventDate.ToString("d MMM yyyy")</p></div>
    <a asp-controller="ManageEvents" asp-action="Index" class="btn btn-outline-ink">Back to my events</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel">
            <h2>Add a category</h2>
            <form asp-action="Create" method="post">
                <input type="hidden" name="EventID" value="@Model.EventID" />
                <div class="mb-3">
                    <label for="cat-name" class="form-label">Name</label>
                    <input id="cat-name" name="Name" class="form-control" placeholder="e.g. 10km Run" required maxlength="50" />
                </div>
                <div class="mb-3">
                    <label for="cat-dist" class="form-label">Distance (km)</label>
                    <input id="cat-dist" name="DistanceKm" type="number" step="0.1" min="0.1" max="1000" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-signal w-100">Add category</button>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        @if (Model.Categories.Count == 0)
        {
            <div class="panel text-muted">This event has no categories yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table">
                    <thead><tr><th>Name</th><th>Distance</th><th class="text-end">Enrolments</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td><strong>@c.Name</strong></td>
                            <td>@Formatting.Km(c.DistanceKm)</td>
                            <td class="text-end">@c.EnrolmentCount</td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Edit" asp-route-eventId="@Model.EventID" asp-route-id="@c.CategoryID" class="btn btn-sm btn-outline-ink">Edit</a>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Remove this category?');">
                                        <input type="hidden" name="eventId" value="@Model.EventID" />
                                        <input type="hidden" name="id" value="@c.CategoryID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
